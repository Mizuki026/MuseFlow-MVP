# Copy the relevant values into the shell that starts the API or test runner.
# The current Python entrypoints read process environment variables directly;
# they do not load this file automatically.

# Current window: PostgreSQL application/test database.
# Replace the application URL with a database whose credentials you control.
# Use the current application database connection here; never commit real credentials.
MUSEFLOW_DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/museflow
# Host-run Compose tests use the PostgreSQL settings from compose.yaml with port 55432.
# Replace the placeholders in the shell environment; keep this example value empty.
MUSEFLOW_TEST_DATABASE_URL=

# Provider variables are required only by the controlled real-provider smoke test.
# Never commit real values.
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=

# Future windows: keep these unset until their corresponding services exist.
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=museflow-results

# Worker execution lease. Heartbeat must be no more than one third of the lease.
MUSEFLOW_LEASE_SECONDS=240
MUSEFLOW_HEARTBEAT_INTERVAL_SECONDS=30

# Maintenance queue worker concurrency is independent from generation workers.
MUSEFLOW_MAINTENANCE_CONCURRENCY=1

# Local Compose only. All published ports bind to 127.0.0.1.
MUSEFLOW_WEB_PORT=5173
MUSEFLOW_API_PORT=8000
MUSEFLOW_POSTGRES_PORT=55432
MUSEFLOW_REDIS_PORT=6379
MUSEFLOW_MINIO_PORT=9000
MUSEFLOW_MINIO_CONSOLE_PORT=9001
MUSEFLOW_PROVIDER=mock

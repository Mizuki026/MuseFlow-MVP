# Copy the relevant values into the shell that starts the API or test runner.
# The current Python entrypoints read process environment variables directly;
# they do not load this file automatically.

# Current window: PostgreSQL application/test database.
# Replace the application URL with a database whose credentials you control.
MUSEFLOW_DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/museflow
# The repository's temporary local integration instance uses trust auth.
MUSEFLOW_TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/museflow

# Provider variables are required only by the controlled real-provider smoke test.
# Never commit real values.
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=

# Future windows: keep these unset until their corresponding services exist.
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=museflow-results
